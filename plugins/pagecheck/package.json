    "accessibility",
    "typography",
    "mobile",
    "layout",
    "audit",
    "playwright",
    "wcag",
    "contrast",
    "claude-code",
    "responsive",
    "viewport",
    "tap-targets",
    "a11y",
    "ui-testing",
    "overflow",
    "web-accessibility"
  ],
  "license": "MIT",
  "author": "Alok Rajasukumaran (https://alokraj68.in)",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/alokraj68"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/alokraj68"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alokraj68/craftkit.git",
    "directory": "plugins/pagecheck"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "pagecheck": "bin/pagecheck.mjs"
  },
  "exports": {
